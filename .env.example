# ── Public (sent to the browser) ────────────────────────────────────────────
# Public site URL, used in coin metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Your dedicated Pinata gateway host, used to resize IPFS images (optional)
NEXT_PUBLIC_PINATA_GATEWAY=

# ── Privy: phone sign-in + recipient wallets (https://dashboard.privy.io) ───
# App ID (Settings → Basics). Enable SMS as the only login method, and Solana wallets.
NEXT_PUBLIC_PRIVY_APP_ID=
# App secret (Settings → Basics). Server only.
PRIVY_APP_SECRET=
# Our server signer: Wallet infrastructure → Authorization keys → create a key, then a key quorum
# containing it. The quorum's id goes here; it's added to every recipient wallet we create, so the
# keeper can collect fees and swap them to USDC inside the recipient's own wallet.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# That authorization key's private key (base64 PKCS8; the "wallet-auth:" prefix is fine). Server only.
PRIVY_AUTHORIZATION_KEY=
# Optional, recommended: a Privy policy restricting what the signer may do (see README).
NEXT_PUBLIC_PRIVY_POLICY_ID=

# ── Neon: the database (server only) ────────────────────────────────────────
# Pooled connection string (Dashboard → Connect). Apply db/migrations/0001_init.sql first.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Solana ──────────────────────────────────────────────────────────────────
# Mainnet RPC with sendTransaction + getTransaction (Helius, Triton, QuickNode, …)
SOLANA_RPC_URL=
# Treasury wallet: pays network fees for recipient wallets (they hold no SOL) and ATA rent.
# Never holds anyone's fees. Keep ~0.2 SOL in it. Base58 secret key or a JSON byte array.
TREASURY_SECRET_KEY=
# Quote asset every coin is paired with. Set to the AAPLx (xStocks) mint — verify the address
# on xstocks.com / an explorer. The server checks pump.fun accepts it before building a launch.
QUOTE_MINT=
# Creator fee in bps (pump.fun must allow configurable creator fees up to this value). 0 = schedule rate.
CREATOR_FEE_BPS=300
# Priority fee for server-built transactions
PRIORITY_FEE_MICRO_LAMPORTS=100000
# Vaults worth less than this (in SOL-equivalent lamports) aren't collected
MIN_SWEEP_LAMPORTS=5000000

# ── Services ────────────────────────────────────────────────────────────────
# Pinata JWT (API Keys → New key with pinFileToIPFS + pinJSONToIPFS)
PINATA_JWT=
# Gateway used in stored metadata/image URIs
IPFS_PUBLIC_GATEWAY=https://ipfs.io
# Jupiter swap/price API. lite-api is keyless; use https://api.jup.ag with JUPITER_API_KEY for higher limits.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
# Card issuer adapter (src/server/cards.ts). "sandbox" issues test cards and moves no money.
CARD_PROVIDER=sandbox
# 32 random bytes as hex: `openssl rand -hex 32`. Encrypts stored card numbers.
CARD_ENCRYPTION_KEY=
# Protects /api/keeper. Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
